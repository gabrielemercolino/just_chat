<Layouts.app flash={@flash}>
  <div class="bg-gray-900 min-h-screen">
    <.top_bar
      version={Application.spec(:just_chat, :vsn)}
      channel={@room_id}
      repo_link="https://github.com/gabrielemercolino/just_chat"
    />

    <%= if @show_modal do %>
      <.room_modal error={@modal_error} />
    <% end %>

    <main class="w-full max-w-[800px] mx-auto px-4 pt-20 pb-[80px]">
      <div
        id="messages"
        phx-hook=".AutoScroll"
        phx-update="stream"
        class="space-y-2"
      >
        <div
          :for={{id, msg} <- @streams.messages}
          id={id}
          class={[
            "max-w-[70%] p-2 rounded shadow-sm break-words",
            msg.from_self && "ml-auto bg-blue-900 text-white text-right",
            !msg.from_self && "mr-auto bg-gray-800 text-gray-100 text-left"
          ]}
        >
          <div class="break-words">{Phoenix.HTML.raw(linkify(msg.body))}</div>
          <div class="text-xs text-gray-400 mt-1">
            {Calendar.strftime(msg.time, "%H:%M %Z")}
          </div>
        </div>
      </div>
    </main>

    <footer class="w-full max-w-[800px] mx-auto fixed bottom-0 left-0 right-0 px-4 py-3 bg-gray-900 border-t border-zinc-800">
      <div class="max-w-[800px] mx-auto">
        <.chat_input input={@input} />
      </div>
    </footer>

    <%!-- Colocated Hooks --%>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".AutoScroll">
      export default {
        updated() {
          const last = this.el.children.length - 1
          if (last < 0) return
          this.el.children[last].scrollIntoView({behavior: "smooth"})
        }
      }
    </script>
  </div>
</Layouts.app>
